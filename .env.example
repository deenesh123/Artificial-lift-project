# ALS Enterprise - Environment Configuration

# Node environment: development | production
NODE_ENV=development

# Server Port & Host (AI Studio default: 3000, 0.0.0.0)
PORT=3000
HOST=0.0.0.0

# Google Gemini API Key for ALS Operations AI Assistant
# Required for live generative responses using gemini-3.8-flash model.
# If left blank, the application automatically activates the local rule-based
# demo assistant using the existing synthetic ALS operations dataset.
GEMINI_API_KEY=
